generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/**
 * Auth (NextAuth) models
 * Docs: https://authjs.dev/ (NextAuth / Auth.js)
 */
model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]

  orders        Order[]
  addresses     Address[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/**
 * Commerce models
 */
model Address {
  id          String  @id @default(cuid())
  userId      String
  label       String? // e.g. "Casa", "Ufficio"
  name        String
  line1       String
  line2       String?
  city        String
  postcode    String
  province    String?
  country     String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  category    String  // "hoodies" | "tshirts"
  tags        Json
  images      Json // relative paths under /public (e.g. "/mock/hoodie.jpg")
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants    Variant[]
}

model Variant {
  id                 String   @id @default(cuid())
  productId          String
  sku                String   @unique
  color              String
  size               String
  priceGrossCents    Int      // IVA inclusa (B2C EU)
  currency           String   @default("EUR")
  stockQty           Int      @default(0)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems         OrderItem[]

  @@index([productId])
  @@index([color])
  @@index([size])
}

model Order {
  id                    String         @id @default(cuid())
  userId                String?
  status                OrderStatus    @default(PENDING)

  email                 String
  phone                 String?

  shippingName          String
  shippingLine1         String
  shippingLine2         String?
  shippingCity          String
  shippingPostcode      String
  shippingProvince      String?
  shippingCountry       String

  shippingMethod        String
  shippingCostCents     Int

  vatRateBps            Int            // e.g. 2200 => 22.00%
  subtotalGrossCents    Int
  vatCents              Int
  totalCents            Int
  currency              String         @default("EUR")

  paymentProvider       PaymentProvider?
  paymentStatus         PaymentStatus  @default(UNPAID)
  paymentRef            String?        // Stripe session id / PayPal order id

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  user                  User?          @relation(fields: [userId], references: [id])
  items                 OrderItem[]
}

model OrderItem {
  id                    String   @id @default(cuid())
  orderId               String
  variantId             String
  quantity              Int
  unitPriceGrossCents   Int
  lineTotalGrossCents   Int

  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant               Variant  @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
}
